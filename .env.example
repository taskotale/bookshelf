# Copy to .env and fill in. Never commit .env.

# Required: signs the session cookie. Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SECURITY_PASSWORD_SALT=

# "Explore as Guest" logs visitors into this user id (read-only unless DEMO_READ_ONLY=0)
DEMO_USER_ID=1
DEMO_READ_ONLY=1

# Where the "Version 2.0" link in the footer points
V2_URL=https://github.com/taskotale/bookshelf

# Optional: raises the Google Books rate limit (free key from console.cloud.google.com)
GOOGLE_BOOKS_API_KEY=

# Optional: only needed for password-reset emails
SENDGRID_API_KEY=
MAIL_DEFAULT_SENDER=
